{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/_next/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/_next/static/$1"
    },
    {
      "src": "/_external/(.*)",
      "dest": "/_external/$1"
    },
    {
      "src": "/music.mp3",
      "headers": {
        "Content-Type": "audio/mpeg",
        "Accept-Ranges": "bytes"
      },
      "dest": "/music.mp3"
    },
    {
      "src": "/wajah.jpeg",
      "dest": "/wajah.jpeg"
    },
    {
      "src": "/IMG_3586.JPG.jpeg",
      "dest": "/IMG_3586.JPG.jpeg"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
